# ── Supabase (waitlist + handle reservation) ─────────────────────────
# Project → Settings → API. The anon key only ever inserts into
# public.waitlist (insert-only RLS, see supabase/migrations/0001_waitlist.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stytch (M0 Gateway — auth shell) ─────────────────────────────────
# console.stytch.com → API keys. Leave empty until the app beta opens;
# the auth shell renders in "beta pending" mode without them.
STYTCH_PROJECT_ID=
STYTCH_SECRET=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# ── Canonical origin ──────────────────────────────────────────────────
# Never per-deployment URLs in public links.
NEXT_PUBLIC_SITE_URL=https://medusacoven.vercel.app
